{
  "theme": "custom:midnight-synthwave",
  "statusLine": {
    "type": "command",
    "command": "node ~/.claude/statusline.mjs",
    "refreshInterval": 30
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "node ~/.claude/subagent-statusline.mjs"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "C:\\Users\\SEU_USUARIO\\.claude\\tarefa-concluida.ps1"],
            "async": true
          }
        ]
      }
    ]
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Sintetizando",
      "Acendendo o neon",
      "Cruzando o grid",
      "Rebobinando a fita",
      "Afinando o sintetizador",
      "Pilotando no pôr do sol",
      "Tramando",
      "Maquinando",
      "Garimpando",
      "Destrinchando",
      "Decifrando",
      "Lapidando",
      "Conjurando",
      "Costurando",
      "Matutando"
    ]
  },
  "spinnerTipsOverride": {
    "excludeDefault": false,
    "tips": [
      "Ctrl+J quebra a linha sem enviar",
      "/theme → Ctrl+E edita o tema atual com preview",
      "Shift+Tab alterna o modo de permissão",
      "Esc duas vezes volta para uma mensagem anterior",
      "Comece com ! para rodar um comando direto no terminal"
    ]
  }
}
